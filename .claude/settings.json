{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm run build)",
      "Bash(npm run test)",
      "Bash(npm run test:*)",
      "Bash(npm run start:dev)",
      "Bash(npm run start)",
      "Bash(npm run db:generate)",
      "Bash(npm run db:migrate)",
      "Bash(npm run db:studio)",
      "Bash(npm run dev)",
      "Bash(npm install:*)",
      "Bash(npm ci)",
      "Bash(npx jest:*)",
      "Bash(npx drizzle-kit:*)",
      "Bash(npx next:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch:*)",
      "Bash(ls)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find . -name:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(curl http://localhost:*)",
      "Bash(curl https://localhost:*)",
      "Bash(docker compose:*)",
      "Bash(docker build:*)",
      "Bash(docker run:*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(npm publish:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(drizzle-kit drop)",
      "Bash(drizzle-kit push)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(npm install:*)",
      "Bash(docker compose down -v)"
    ]
  },
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1"
  }
}
