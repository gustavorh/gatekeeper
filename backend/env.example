# Database Configuration
# Opción 1: URL completa (recomendado para desarrollo)
DATABASE_URL=mysql://usuario:contraseña@localhost:3306/gatekeeper

# Opción 2: Variables separadas (recomendado para producción)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=usuario
# DB_PASSWORD=contraseña
# DB_NAME=gatekeeper

# JWT Configuration (JWT_SECRET requerido, mínimo 16 caracteres)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1d

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS (lista CSV de orígenes permitidos)
FRONTEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000

# Throttling (rate limit global y específico de auth)
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL=60
THROTTLE_AUTH_LIMIT=5

# Logging level (debug | info | warn | error) — default: info
LOG_LEVEL=info

# Admin seed (requerido sólo al ejecutar pnpm db:seed)
SEED_ADMIN_PASSWORD=change-me-before-seeding
# SEED_ADMIN_RUT=111111111
# SEED_ADMIN_EMAIL=admin@gatekeeper.local
# SEED_ADMIN_FIRST_NAME=Admin
# SEED_ADMIN_LAST_NAME=Gatekeeper

# Bull / Redis (opcional — sólo si BullMQ está activo)
# BULL_REDIS_URL=redis://localhost:6379
